# NetMapper ortam değişkenleri — kopyalayıp .env olarak kullanın.
# .env GİT'E GİRMEZ (.gitignore).

# ---------------------------------------------------------------- genel
# Varsayılan timeout (sn)
NETMAPPER_DEFAULT_TIMEOUT_SEC=300
# Veritabanı (varsayılan: sqlite dosyası)
# DATABASE_URL=sqlite+aiosqlite:///./netmapper.db

# ------------------------------------------------------------ API güvenliği
# UZAK ERİŞİMDE MUTLAKA AYARLAYIN: tüm /api/v1/* uçları ve WebSocket
# bu token'ı ister (X-API-Token header / "Authorization: Bearer" / WS ?token=).
# Boş bırakılırsa kimlik doğrulama KAPALIDUR (yalnızca localhost kullanımı).
# Üretimde: openssl rand -hex 32
API_TOKEN=

# --------------------------------------------------- SÖMÜR (Auto-Pwn) modülü
# Üç kapı birlikte: (1) EXPLOIT_ENABLED  (2) EXPLOIT_ALLOWLIST  (3) confirm=SÖMÜR
# Varsayılanlar: modül KAPALI, allowlist BOŞ (fail-closed).
EXPLOIT_ENABLED=false
# Virgül ayrılmış CIDR/IP listesi — hedefin ÇÖZÜMLENEN TÜM IP'leri bu
# listede olmalı (hostname'ler DNS'e çözülür; tek bir adres dışarıdaysa reddedilir).
# EXPLOIT_ALLOWLIST=10.13.38.0/24,192.168.56.7
EXPLOIT_ALLOWLIST=
# Zincir sonunda sahte makine hesabı silinsin mi (silme LDAP ile DOĞRULANIR)
EXPLOIT_CLEANUP=true
# İndirilen biletlerin (ccache) saklama süresi — gün; süresi dolan iş
# dizinleri sunucu açılışında silinir.
TICKETS_RETENTION_DAYS=7
